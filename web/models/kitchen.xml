<mujoco model="handover_kitchen">
  <!-- Handover level 1: kitchen. The SO-101 arm sits on the kitchen table.
       Units: meters, kilograms, radians. World z is up; the robot faces +x. -->
  <include file="so101/so101.xml"/>
  <!-- The room around the table (walls, kitchen units, window, chair, lights). Visual
       only apart from the floor, and no free bodies, so it does not change qpos. -->
  <include file="kitchen/room.xml"/>

  <compiler meshdir="so101/assets"/>
  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="200" elevation="-30" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <material name="wood" rgba="0.62 0.45 0.30 1"/>
    <material name="cup" rgba="0.20 0.55 0.85 1"/>
    <material name="tray" rgba="0.30 0.65 0.45 1"/>
    <material name="pills" rgba="0.95 0.55 0.15 1"/>
    <material name="pills_cap" rgba="0.95 0.95 0.95 1"/>
    <material name="hand_zone" rgba="0.95 0.35 0.45 0.25"/>
  </asset>

  <default>
    <default class="furniture">
      <!-- Lacquered wood / melamine: Coulomb friction about 0.4 against ceramic or plastic. -->
      <geom contype="1" conaffinity="1" condim="3" friction="0.4 0.005 0.0001"/>
    </default>
    <default class="prop">
      <!-- Graspable objects (glazed ceramic, PP plastic): sliding friction 0.35. MuJoCo uses the
           larger of the two geoms, so props slide on the table at 0.4. The SO-101 jaws have
           contact priority, so grasps use the jaws' own friction. Torsional friction is about
           mu * contact radius; rolling resistance of hard objects is small. -->
      <geom contype="1" conaffinity="1" condim="4" friction="0.35 0.004 0.0001" solref="0.01 1"/>
    </default>
  </default>

  <worldbody>
    <!-- Kitchen table. Top surface is at z = 0 so the robot base and props sit at z = 0. -->
    <body name="table" pos="0.15 0 0">
      <geom name="table_top" type="box" size="0.35 0.45 0.02" pos="0 0 -0.02" material="wood" class="furniture"/>
      <geom type="box" size="0.02 0.02 0.355" pos="0.31 0.41 -0.395" material="wood" class="furniture"/>
      <geom type="box" size="0.02 0.02 0.355" pos="0.31 -0.41 -0.395" material="wood" class="furniture"/>
      <geom type="box" size="0.02 0.02 0.355" pos="-0.31 0.41 -0.395" material="wood" class="furniture"/>
      <geom type="box" size="0.02 0.02 0.355" pos="-0.31 -0.41 -0.395" material="wood" class="furniture"/>
    </body>

    <!-- Tray: fixed to the table. Its inner floor is the "cup on tray" target region. -->
    <body name="tray" pos="0.20 -0.15 0">
      <geom name="tray_floor" type="box" size="0.07 0.055 0.003" pos="0 0 0.003" material="tray" class="furniture"/>
      <geom type="box" size="0.07 0.003 0.008" pos="0 0.055 0.008" material="tray" class="furniture"/>
      <geom type="box" size="0.07 0.003 0.008" pos="0 -0.055 0.008" material="tray" class="furniture"/>
      <geom type="box" size="0.003 0.055 0.008" pos="0.07 0 0.008" material="tray" class="furniture"/>
      <geom type="box" size="0.003 0.055 0.008" pos="-0.07 0 0.008" material="tray" class="furniture"/>
      <site name="tray_center" pos="0 0 0.006" size="0.005" rgba="0 0 0 0"/>
    </body>

    <!-- Cup: a small (espresso-size) porcelain cup the SO-101 gripper can close around.
         4 cm across, 7 cm tall, 3 mm walls, 5 mm base, porcelain 2300 kg/m^3, plus a 6 g
         handle: 73 g. The inertial is that of the hollow cup (centre of mass 3.1 cm up),
         not of a solid cylinder; see tools/kitchen_inertia.py. -->
    <body name="cup" pos="0.22 0.10 0">
      <freejoint name="cup_free"/>
      <inertial pos="0 0.002 0.031" mass="0.073" diaginertia="4.6e-5 4.3e-5 2.4e-5"/>
      <geom name="cup_body" type="cylinder" size="0.02 0.035" pos="0 0 0.035" material="cup" class="prop"/>
      <geom name="cup_handle" type="box" size="0.004 0.012 0.015" pos="0 0.024 0.04" material="cup" class="prop"/>
      <site name="cup_top" pos="0 0 0.07" size="0.004" rgba="0 0 0 0"/>
    </body>

    <!-- Medicine bottle (for the "bring medication" task): a pharmacy pill vial, 3 cm across,
         PP plastic with 1.2 mm walls (7 g), 10 g of tablets at the bottom, 3 g cap: 20 g,
         centre of mass 2.5 cm up. -->
    <body name="pill_bottle" pos="0.27 -0.02 0">
      <freejoint name="pill_bottle_free"/>
      <inertial pos="0 0 0.025" mass="0.020" diaginertia="1.1e-5 1.1e-5 2.3e-6"/>
      <geom name="pill_bottle_body" type="cylinder" size="0.015 0.03" pos="0 0 0.03" material="pills" class="prop"/>
      <geom name="pill_bottle_cap" type="cylinder" size="0.016 0.006" pos="0 0 0.066" material="pills_cap" class="prop"/>
    </body>

    <!-- Where the (future) person's hand waits for a handover. Visual only. -->
    <site name="hand_zone" type="sphere" size="0.04" pos="0.12 0.28 0.12" material="hand_zone"/>

    <!-- Default play camera: behind and above the robot, looking along +x. -->
    <camera name="play" pos="-0.35 0 0.38" xyaxes="0 -1 0 0.6 0 0.8" fovy="50"/>
  </worldbody>

  <keyframe>
    <!-- Ready pose: arm raised, jaws horizontal and open. -->
    <key name="ready"
         qpos="0 -0.9 0.9 1.0 1.5708 0.9
               0.22 0.10 0 1 0 0 0
               0.27 -0.02 0 1 0 0 0"
         ctrl="0 -0.9 0.9 1.0 1.5708 0.9"/>
  </keyframe>
</mujoco>
