<!--
  Handover kitchen room: everything around the robot's table.

  Frame (shared with kitchen.xml): z up, metres. The table top is z = 0, the
  robot base is at the origin facing +x, and the floor is z = -0.75 (a 75 cm
  kitchen table). The kitchen units run along the wall the robot faces (+x),
  so they fill the play camera's background; the person receiving a handover
  sits on the +y side of the table, next to the hand zone; the window is in
  the -y wall. Real-world sizes used here (EU / DIN 68935 kitchen norms):
    base cabinets 60 cm deep, worktop at 90 cm, 4 cm worktop, 10 cm plinth,
    wall cabinets 35 cm deep starting 55 cm above the worktop, room 2.6 m high.

  Only the floor collides (so a dropped object lands where it would in a real
  kitchen). Everything else is visual only (contype/conaffinity 0), so the room
  adds no collision work to the physics step. Nothing here is a free body, so
  the "ready" keyframe in kitchen.xml is unaffected.
-->
<mujoco model="kitchen_room">
  <default>
    <default class="room">
      <geom type="box" contype="0" conaffinity="0" group="0" density="0"/>
      <default class="room_cyl">
        <geom type="cylinder"/>
      </default>
      <default class="room_cap">
        <geom type="capsule"/>
      </default>
    </default>
  </default>

  <asset>
    <!-- 30 x 30 cm floor tiles with grout lines (a checker texture spans 2 x 2 tiles). -->
    <texture name="tex_floor_tiles" type="2d" builtin="checker" mark="edge" width="512" height="512"
      rgb1="0.78 0.76 0.72" rgb2="0.74 0.72 0.68" markrgb="0.55 0.53 0.50"/>
    <material name="floor_tiles" texture="tex_floor_tiles" texrepeat="1.667 1.667" texuniform="true"
      specular="0.25" shininess="0.4" reflectance="0.04"/>
    <!-- 10 x 10 cm wall tiles behind the worktop (2 x 2 tiles per texture). -->
    <texture name="tex_splash_tiles" type="2d" builtin="checker" mark="edge" width="256" height="256"
      rgb1="0.93 0.94 0.95" rgb2="0.93 0.94 0.95" markrgb="0.70 0.70 0.70"/>
    <material name="splash_tiles" texture="tex_splash_tiles" texrepeat="5 5" texuniform="true"
      specular="0.6" shininess="0.8"/>

    <material name="wall_paint" rgba="0.90 0.88 0.83 1" specular="0.05" shininess="0.1"/>
    <material name="skirting" rgba="0.95 0.95 0.94 1" specular="0.2" shininess="0.3"/>
    <material name="cabinet_front" rgba="0.36 0.45 0.42 1" specular="0.25" shininess="0.5"/>
    <material name="cabinet_carcass" rgba="0.86 0.86 0.84 1" specular="0.1" shininess="0.2"/>
    <material name="plinth" rgba="0.18 0.18 0.18 1" specular="0.1" shininess="0.2"/>
    <material name="worktop_oak" rgba="0.62 0.45 0.29 1" specular="0.2" shininess="0.35"/>
    <material name="brushed_steel" rgba="0.70 0.71 0.72 1" specular="0.8" shininess="0.7" reflectance="0.15" metallic="0.9" roughness="0.35"/>
    <material name="dark_steel" rgba="0.30 0.31 0.32 1" specular="0.7" shininess="0.6" metallic="0.9" roughness="0.4"/>
    <material name="hob_glass" rgba="0.05 0.05 0.06 1" specular="0.9" shininess="0.95" reflectance="0.2" roughness="0.05"/>
    <material name="hob_ring" rgba="0.22 0.22 0.24 1" specular="0.3" shininess="0.5"/>
    <material name="fridge_white" rgba="0.94 0.94 0.93 1" specular="0.5" shininess="0.6"/>
    <material name="window_frame" rgba="0.97 0.97 0.97 1" specular="0.3" shininess="0.4"/>
    <material name="window_sky" rgba="0.80 0.90 1.00 1" emission="0.9" specular="0"/>
    <material name="chair_wood" rgba="0.50 0.34 0.20 1" specular="0.2" shininess="0.3"/>
    <material name="ceramic_white" rgba="0.95 0.95 0.93 1" specular="0.7" shininess="0.8"/>
    <material name="plastic_red" rgba="0.75 0.12 0.10 1" specular="0.4" shininess="0.6"/>
    <material name="cutting_board" rgba="0.80 0.65 0.45 1" specular="0.1" shininess="0.2"/>
    <material name="apple_green" rgba="0.45 0.70 0.20 1" specular="0.5" shininess="0.6"/>
    <material name="apple_red" rgba="0.70 0.10 0.08 1" specular="0.5" shininess="0.6"/>
    <material name="paper" rgba="0.97 0.97 0.95 1" specular="0" shininess="0"/>
    <material name="plant_pot" rgba="0.72 0.38 0.24 1" specular="0.1" shininess="0.2"/>
    <material name="leaf" rgba="0.20 0.45 0.18 1" specular="0.2" shininess="0.3"/>
    <material name="lamp_shade" rgba="0.95 0.93 0.86 1" emission="0.35" specular="0.1"/>
    <material name="cable_black" rgba="0.08 0.08 0.08 1"/>
  </asset>

  <worldbody>
    <!-- Lighting: soft daylight from the window side plus a pendant lamp over the table. -->
    <light name="window_daylight" pos="0.6 -1.8 1.2" dir="-0.1 1 -0.6" directional="true"
      diffuse="0.55 0.55 0.52" specular="0.15 0.15 0.15" castshadow="true"/>
    <light name="pendant_lamp" pos="0.15 0 0.98" dir="0 0 -1" cutoff="70" exponent="2"
      attenuation="1 0 0.15" diffuse="0.55 0.50 0.42" specular="0.2 0.2 0.2" castshadow="true"/>

    <!-- Floor: the only colliding room geom. 30 cm tiles. -->
    <geom name="floor" type="plane" pos="0.25 0 -0.75" size="1.75 1.9 0.05" material="floor_tiles"
      friction="0.6 0.005 0.0001"/>

    <body name="kitchen_room" childclass="room">
      <!-- Walls: 2.6 m high. Behind the robot (-x), behind the person (+y), window wall (-y). -->
      <geom name="wall_behind_robot" pos="-1.525 0 0.55" size="0.025 1.95 1.3" material="wall_paint"/>
      <geom name="wall_person_side" pos="0.25 1.925 0.55" size="1.8 0.025 1.3" material="wall_paint"/>
      <geom name="wall_window_side" pos="0.25 -1.925 0.55" size="1.8 0.025 1.3" material="wall_paint"/>
      <geom name="skirting_person_side" pos="0.25 1.894 -0.71" size="1.8 0.006 0.04" material="skirting"/>
      <geom name="skirting_window_side" pos="0.25 -1.894 -0.71" size="1.8 0.006 0.04" material="skirting"/>
      <geom name="skirting_behind_robot" pos="-1.494 0 -0.71" size="0.006 1.9 0.04" material="skirting"/>

      <!-- Window in the -y wall: sill at 90 cm, 1.2 x 1.2 m. -->
      <geom name="window_glass" pos="0.4 -1.898 0.75" size="0.6 0.004 0.6" material="window_sky"/>
      <geom name="window_frame_top" pos="0.4 -1.89 1.37" size="0.64 0.02 0.03" material="window_frame"/>
      <geom name="window_frame_bot" pos="0.4 -1.89 0.13" size="0.64 0.02 0.03" material="window_frame"/>
      <geom name="window_frame_l" pos="-0.22 -1.89 0.75" size="0.03 0.02 0.6" material="window_frame"/>
      <geom name="window_frame_r" pos="1.02 -1.89 0.75" size="0.03 0.02 0.6" material="window_frame"/>
      <geom name="window_mullion" pos="0.4 -1.89 0.75" size="0.02 0.015 0.6" material="window_frame"/>
      <geom name="window_sill" pos="0.4 -1.83 0.14" size="0.68 0.08 0.015" material="window_frame"/>
      <!-- Potted herb on the sill. -->
      <geom name="sill_pot" class="room_cyl" pos="0.75 -1.83 0.215" size="0.06 0.06" material="plant_pot"/>
      <geom name="sill_plant_1" type="ellipsoid" pos="0.75 -1.83 0.33" size="0.08 0.07 0.07" material="leaf"/>
      <geom name="sill_plant_2" type="ellipsoid" pos="0.71 -1.81 0.39" size="0.05 0.05 0.06" material="leaf"/>

      <!-- Kitchen units along the +x wall. Modelled facing +x in local coordinates
           and turned 180 degrees, so local x = -1.9 is the wall at world x = 1.95. -->
      <body name="kitchen_units" pos="0.05 0 0" euler="0 0 3.14159265">
      <geom name="wall_units" pos="-1.925 0 0.55" size="0.025 1.95 1.3" material="wall_paint"/>
      <!-- Base cabinet run along the back wall: y in [-1.2, 1.2], 60 cm deep. -->
      <geom name="counter_plinth" pos="-1.58 0 -0.70" size="0.27 1.2 0.05" material="plinth"/>
      <geom name="counter_carcass" pos="-1.61 0 -0.27" size="0.29 1.2 0.38" material="cabinet_carcass"/>
      <geom name="counter_door_1" pos="-1.311 -0.9 -0.27" size="0.009 0.297 0.375" material="cabinet_front"/>
      <geom name="counter_door_2" pos="-1.311 -0.3 -0.27" size="0.009 0.297 0.375" material="cabinet_front"/>
      <geom name="counter_door_3" pos="-1.311 0.3 -0.27" size="0.009 0.297 0.375" material="cabinet_front"/>
      <geom name="counter_door_4" pos="-1.311 0.9 -0.27" size="0.009 0.297 0.375" material="cabinet_front"/>
      <geom name="counter_handle_1" class="room_cap" pos="-1.295 -0.9 0.04" euler="1.5708 0 0" size="0.006 0.08" material="brushed_steel"/>
      <geom name="counter_handle_2" class="room_cap" pos="-1.295 -0.3 0.04" euler="1.5708 0 0" size="0.006 0.08" material="brushed_steel"/>
      <geom name="counter_handle_3" class="room_cap" pos="-1.295 0.3 0.04" euler="1.5708 0 0" size="0.006 0.08" material="brushed_steel"/>
      <geom name="counter_handle_4" class="room_cap" pos="-1.295 0.9 0.04" euler="1.5708 0 0" size="0.006 0.08" material="brushed_steel"/>

      <!-- Oak worktop at 90 cm (top face z = 0.15), with a cut-out for the sink at y in [0.35, 0.75]. -->
      <geom name="worktop_a" pos="-1.6 -0.425 0.13" size="0.31 0.775 0.02" material="worktop_oak"/>
      <geom name="worktop_b" pos="-1.6 0.975 0.13" size="0.31 0.225 0.02" material="worktop_oak"/>
      <geom name="worktop_back" pos="-1.825 0.55 0.13" size="0.085 0.2 0.02" material="worktop_oak"/>
      <geom name="worktop_front" pos="-1.345 0.55 0.13" size="0.055 0.2 0.02" material="worktop_oak"/>
      <geom name="backsplash" pos="-1.897 0 0.45" size="0.003 1.2 0.30" material="splash_tiles"/>

      <!-- Stainless sink, 40 x 35 cm, 18 cm deep, with a faucet. -->
      <geom name="sink_bottom" pos="-1.575 0.55 -0.03" size="0.165 0.19 0.004" material="brushed_steel"/>
      <geom name="sink_wall_back" pos="-1.738 0.55 0.06" size="0.002 0.2 0.09" material="brushed_steel"/>
      <geom name="sink_wall_front" pos="-1.412 0.55 0.06" size="0.002 0.2 0.09" material="brushed_steel"/>
      <geom name="sink_wall_l" pos="-1.575 0.748 0.06" size="0.165 0.002 0.09" material="brushed_steel"/>
      <geom name="sink_wall_r" pos="-1.575 0.352 0.06" size="0.165 0.002 0.09" material="brushed_steel"/>
      <geom name="sink_drain" class="room_cyl" pos="-1.575 0.55 -0.024" size="0.03 0.002" material="dark_steel"/>
      <geom name="faucet_base" class="room_cyl" pos="-1.82 0.55 0.18" size="0.022 0.03" material="brushed_steel"/>
      <geom name="faucet_riser" class="room_cap" pos="-1.82 0.55 0.32" size="0.012 0.12" material="brushed_steel"/>
      <geom name="faucet_spout" class="room_cap" fromto="-1.82 0.55 0.44 -1.66 0.55 0.44" size="0.011" material="brushed_steel"/>
      <geom name="faucet_tip" class="room_cap" fromto="-1.66 0.55 0.44 -1.66 0.55 0.40" size="0.011" material="brushed_steel"/>
      <geom name="faucet_lever" class="room_cap" fromto="-1.82 0.55 0.24 -1.82 0.47 0.27" size="0.006" material="brushed_steel"/>

      <!-- Induction hob, 58 x 51 cm, set into the worktop at y = -0.6. -->
      <geom name="hob" pos="-1.60 -0.6 0.152" size="0.255 0.29 0.003" material="hob_glass"/>
      <geom name="hob_ring_1" class="room_cyl" pos="-1.70 -0.72 0.1555" size="0.09 0.0005" material="hob_ring"/>
      <geom name="hob_ring_2" class="room_cyl" pos="-1.70 -0.48 0.1555" size="0.07 0.0005" material="hob_ring"/>
      <geom name="hob_ring_3" class="room_cyl" pos="-1.48 -0.72 0.1555" size="0.07 0.0005" material="hob_ring"/>
      <geom name="hob_ring_4" class="room_cyl" pos="-1.48 -0.48 0.1555" size="0.09 0.0005" material="hob_ring"/>

      <!-- Wall cabinets, 35 cm deep, from 1.45 m to 2.15 m above the floor; extractor hood over the hob. -->
      <geom name="upper_cab_l" pos="-1.725 0.6 1.05" size="0.175 0.6 0.35" material="cabinet_carcass"/>
      <geom name="upper_door_1" pos="-1.541 0.3 1.05" size="0.009 0.297 0.347" material="cabinet_front"/>
      <geom name="upper_door_2" pos="-1.541 0.9 1.05" size="0.009 0.297 0.347" material="cabinet_front"/>
      <geom name="upper_handle_1" class="room_cap" pos="-1.525 0.3 0.76" euler="0 1.5708 1.5708" size="0.006 0.08" material="brushed_steel"/>
      <geom name="upper_handle_2" class="room_cap" pos="-1.525 0.9 0.76" euler="0 1.5708 1.5708" size="0.006 0.08" material="brushed_steel"/>
      <geom name="upper_cab_r" pos="-1.725 -1.05 1.05" size="0.175 0.15 0.35" material="cabinet_carcass"/>
      <geom name="upper_door_3" pos="-1.541 -1.05 1.05" size="0.009 0.147 0.347" material="cabinet_front"/>
      <geom name="hood" pos="-1.65 -0.6 0.82" size="0.25 0.3 0.04" material="brushed_steel"/>
      <geom name="hood_chimney" pos="-1.80 -0.6 1.22" size="0.10 0.14 0.36" material="brushed_steel"/>

      <!-- Fridge-freezer in the corner, 60 x 65 x 185 cm. -->
      <geom name="fridge" pos="-1.57 -1.55 0.175" size="0.325 0.30 0.925" material="fridge_white"/>
      <geom name="fridge_gap" pos="-1.244 -1.55 0.45" size="0.002 0.298 0.004" material="dark_steel"/>
      <geom name="fridge_handle_top" class="room_cap" pos="-1.225 -1.30 0.70" size="0.008 0.18" material="brushed_steel"/>
      <geom name="fridge_handle_bot" class="room_cap" pos="-1.225 -1.30 0.20" size="0.008 0.15" material="brushed_steel"/>

      <!-- Things on the worktop (out of the arm's reach; decoration only). -->
      <geom name="kettle_body" class="room_cyl" pos="-1.72 0.12 0.25" size="0.075 0.10" material="brushed_steel"/>
      <geom name="kettle_lid" type="ellipsoid" pos="-1.72 0.12 0.35" size="0.07 0.07 0.025" material="cable_black"/>
      <geom name="kettle_handle" class="room_cap" fromto="-1.72 0.20 0.33 -1.72 0.20 0.18" size="0.012" material="cable_black"/>
      <geom name="kettle_spout" class="room_cap" fromto="-1.72 0.06 0.30 -1.72 0.02 0.33" size="0.012" material="brushed_steel"/>
      <geom name="cutting_board" pos="-1.62 -0.05 0.16" size="0.15 0.10 0.01" euler="0 0 0.15" material="cutting_board"/>
      <geom name="fruit_bowl" type="ellipsoid" pos="-1.60 1.00 0.19" size="0.12 0.12 0.04" material="ceramic_white"/>
      <geom name="apple_1" type="sphere" pos="-1.62 0.97 0.235" size="0.037" material="apple_red"/>
      <geom name="apple_2" type="sphere" pos="-1.56 1.03 0.235" size="0.036" material="apple_green"/>
      <geom name="apple_3" type="sphere" pos="-1.64 1.05 0.24" size="0.035" material="apple_red"/>
      <geom name="towel_roll" class="room_cyl" pos="-1.80 -0.15 0.28" size="0.06 0.13" material="paper"/>
      <geom name="dish_soap" class="room_cyl" pos="-1.82 0.80 0.24" size="0.03 0.09" material="plastic_red"/>

      </body>

      <!-- A chair on the +y side of the table, where the person receiving the handover sits
           (next to the hand zone). Its back faces away from the table. -->
      <body name="chair" pos="0.30 0.78 -0.75" euler="0 0 1.5708">
        <geom name="chair_seat" pos="0 0 0.45" size="0.21 0.21 0.02" material="chair_wood"/>
        <geom name="chair_leg_1" pos="0.18 0.18 0.215" size="0.018 0.018 0.215" material="chair_wood"/>
        <geom name="chair_leg_2" pos="0.18 -0.18 0.215" size="0.018 0.018 0.215" material="chair_wood"/>
        <geom name="chair_leg_3" pos="-0.18 0.18 0.215" size="0.018 0.018 0.215" material="chair_wood"/>
        <geom name="chair_leg_4" pos="-0.18 -0.18 0.215" size="0.018 0.018 0.215" material="chair_wood"/>
        <geom name="chair_back_l" pos="0.19 0.18 0.70" size="0.018 0.018 0.24" material="chair_wood"/>
        <geom name="chair_back_r" pos="0.19 -0.18 0.70" size="0.018 0.018 0.24" material="chair_wood"/>
        <geom name="chair_back_rail" pos="0.19 0 0.86" size="0.015 0.20 0.06" material="chair_wood"/>
      </body>

      <!-- Pendant lamp over the table (the matching light is "pendant_lamp" above). -->
      <geom name="lamp_cable" class="room_cap" fromto="0.15 0 1.85 0.15 0 1.15" size="0.003" material="cable_black"/>
      <geom name="lamp_shade" type="ellipsoid" pos="0.15 0 1.10" size="0.18 0.18 0.07" material="lamp_shade"/>
    </body>
  </worldbody>
</mujoco>
